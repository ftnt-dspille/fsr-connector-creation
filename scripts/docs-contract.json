{
  "$comment": "GENERATED by scripts/emit-contract.js -- do not hand-edit. Run `npm run contract`.",
  "extensionId": "fortisoar.fortisoar-connector",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "commands": {
    "fortisoar.newConnector": {
      "title": "FortiSOAR: New Connector",
      "label": "New Connector"
    },
    "fortisoar.installSample": {
      "title": "FortiSOAR: Install Sample Connector",
      "label": "Install Sample Connector"
    },
    "fortisoar.importFromFolder": {
      "title": "FortiSOAR: Import Connector from Folder",
      "label": "Import Connector from Folder"
    },
    "fortisoar.importFromTarball": {
      "title": "FortiSOAR: Import Connector (from tgz)",
      "label": "Import Connector (from tgz)"
    },
    "fortisoar.runOperation": {
      "title": "FortiSOAR: Run Operation",
      "label": "Run Operation"
    },
    "fortisoar.debugOperation": {
      "title": "FortiSOAR: Debug Operation",
      "label": "Debug Operation"
    },
    "fortisoar.runLast": {
      "title": "FortiSOAR: Run Last Operation",
      "label": "Run Last Operation"
    },
    "fortisoar.configureConnector": {
      "title": "FortiSOAR: Configure Connector",
      "label": "Configure Connector"
    },
    "fortisoar.exportTarball": {
      "title": "FortiSOAR: Export Connector as Tarball",
      "label": "Export Connector as Tarball"
    },
    "fortisoar.newVersion": {
      "title": "FortiSOAR: New Version",
      "label": "New Version"
    },
    "fortisoar.removeConnector": {
      "title": "FortiSOAR: Remove from List",
      "label": "Remove from List"
    },
    "fortisoar.checkHealth": {
      "title": "FortiSOAR: Check Health",
      "label": "Check Health"
    },
    "fortisoar.revealInOS": {
      "title": "FortiSOAR: Reveal in Finder/Explorer",
      "label": "Reveal in Finder/Explorer"
    },
    "fortisoar.refreshTree": {
      "title": "FortiSOAR: Refresh",
      "label": "Refresh"
    },
    "fortisoar.checkPython": {
      "title": "FortiSOAR: Check Python Setup",
      "label": "Check Python Setup"
    },
    "fortisoar.resetPythonEnvironment": {
      "title": "FortiSOAR: Reset Python Environment",
      "label": "Reset Python Environment"
    },
    "fortisoar.initTests": {
      "title": "FortiSOAR: Scaffold Tests",
      "label": "Scaffold Tests"
    },
    "fortisoar.runTestsMocked": {
      "title": "FortiSOAR: Run Tests (Mocked)",
      "label": "Run Tests (Mocked)"
    },
    "fortisoar.runTestsLive": {
      "title": "FortiSOAR: Run Tests (Live)",
      "label": "Run Tests (Live)"
    },
    "fortisoar.debugTestsMocked": {
      "title": "FortiSOAR: Debug Tests (Mocked)",
      "label": "Debug Tests (Mocked)"
    },
    "fortisoar.debugTestsLive": {
      "title": "FortiSOAR: Debug Tests (Live)",
      "label": "Debug Tests (Live)"
    },
    "fortisoar.runOperationTests": {
      "title": "FortiSOAR: Run Tests for Operation",
      "label": "Run Tests for Operation"
    },
    "fortisoar.addOperation": {
      "title": "FortiSOAR: Add Operation",
      "label": "Add Operation"
    },
    "fortisoar.resetTestEnvironment": {
      "title": "FortiSOAR: Reset Test Environment",
      "label": "Reset Test Environment"
    },
    "fortisoar.openWalkthrough": {
      "title": "FortiSOAR: Open Walkthrough",
      "label": "Open Walkthrough"
    }
  },
  "settings": [
    "fortisoar.pythonPath",
    "fortisoar.testFramework"
  ],
  "views": [
    {
      "container": "fortisoar",
      "id": "fortisoarConnectors",
      "name": "Connectors"
    }
  ],
  "menus": {
    "view/title": [
      {
        "command": "fortisoar.importFromTarball",
        "when": "view == fortisoarConnectors",
        "group": "navigation@2"
      },
      {
        "command": "fortisoar.newConnector",
        "when": "view == fortisoarConnectors",
        "group": "navigation@1"
      },
      {
        "command": "fortisoar.openWalkthrough",
        "when": "view == fortisoarConnectors",
        "group": "navigation@0"
      },
      {
        "command": "fortisoar.refreshTree",
        "when": "view == fortisoarConnectors",
        "group": "navigation"
      }
    ],
    "view/item/context": [
      {
        "command": "fortisoar.addOperation",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "2_build@0"
      },
      {
        "command": "fortisoar.checkHealth",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "1_run@4"
      },
      {
        "command": "fortisoar.configureConnector",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "1_run@3"
      },
      {
        "command": "fortisoar.debugTestsLive",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "1_run@8"
      },
      {
        "command": "fortisoar.debugTestsMocked",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "1_run@7"
      },
      {
        "command": "fortisoar.exportTarball",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "2_build@2"
      },
      {
        "command": "fortisoar.initTests",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "2_build@1"
      },
      {
        "command": "fortisoar.newVersion",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "2_build@3"
      },
      {
        "command": "fortisoar.removeConnector",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "9_destructive@1"
      },
      {
        "command": "fortisoar.revealInOS",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "3_navigation@1"
      },
      {
        "command": "fortisoar.runOperation",
        "when": "view == fortisoarConnectors && viewItem == operation",
        "group": "1_run@1"
      },
      {
        "command": "fortisoar.runTestsLive",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "1_run@6"
      },
      {
        "command": "fortisoar.runTestsMocked",
        "when": "view == fortisoarConnectors && viewItem == connector",
        "group": "1_run@5"
      }
    ]
  },
  "walkthroughs": [
    {
      "id": "getStarted",
      "title": "Get Started with FortiSOAR Connectors",
      "steps": [
        {
          "id": "openFolder",
          "title": "Open a project folder"
        },
        {
          "id": "setupPython",
          "title": "Set up Python"
        },
        {
          "id": "getConnector",
          "title": "Get a connector"
        },
        {
          "id": "configure",
          "title": "Configure credentials"
        },
        {
          "id": "run",
          "title": "Run your first operation"
        },
        {
          "id": "debug",
          "title": "Debug with breakpoints"
        },
        {
          "id": "tests",
          "title": "Write tests"
        },
        {
          "id": "export",
          "title": "Export a tarball"
        }
      ]
    }
  ]
}
